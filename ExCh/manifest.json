{
  "manifest_version": 3,
  "name": "Abner Dashboard",
  "version": "1.32.92",
  "description": "داشبورد شیشه‌ای نیوتب شامل تقویم، ساعت، آب‌وهوا و تسک",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_title": "Abner Dashboard"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://ipapi.co/*",
    "https://*.ipapi.co/*"
  ]
}